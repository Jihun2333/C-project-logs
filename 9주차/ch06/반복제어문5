#include <stdio.h>
int main() {
    int even = 0, odd = 0;
    for (int i = 0; i < 10; i++) {
        int n;
        scanf("%d", &n);
        if (n % 2 == 0) {
            even++;
        } else {
            odd++;
        }
    }
    printf("even : %d\n", even);
    printf("odd : %d", odd);
    return 0;
}
