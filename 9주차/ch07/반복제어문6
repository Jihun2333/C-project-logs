#include <stdio.h>
int main() {
    int n;
    scanf("%d", &n);
    int cnt = 1;
    for (int i = 0; i < n; i++) {
        for (int k = 0; k < i; k++) {
            printf("  ");
        }
        for (int j = 0; j < n - i; j++) {
            printf("%d", cnt++);
            if (j < n - i - 1) {
                printf(" ");
            }
        }
        printf("\n");
    }
    return 0;
}
