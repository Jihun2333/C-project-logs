#include <stdio.h>

struct Person {
    char name[21];
    int age;
};

int main() {
    struct Person me = {"Yejun", 12};
    struct Person fr;

    scanf("%s %d", fr.name, &fr.age);

    printf("Your name: %s, age: %d\n", me.name, me.age);
    printf("Friend's name: %s, age: %d\n", fr.name, fr.age);

    return 0;
}
